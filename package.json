{
  "name": "react-native-alarms",
  "version": "0.0.10",
  "description": "A powerful, cross-platform alarm management library for React Native",
  "private": false,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./service": {
      "types": "./AlarmService.ts",
      "default": "./AlarmService.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "prepare": "husky",
    "build": "tsc",
    "clean": "rm -rf dist types *.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/surajprasad13/react-native-alarms"
  },
  "keywords": [
    "react-native",
    "alarm",
    "notification",
    "schedule",
    "cross-platform",
    "ios",
    "android"
  ],
  "author": {
    "name": "Suraj Prasad",
    "email": "surajvishwakarma830@gmail.com",
    "url": "https://github.com/surajprasad13"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}